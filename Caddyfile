# JudiFiles — Caddy (HTTPS automático para judifiles.com.br).
#
# Caminho do tráfego: cliente -> caddy:80/443 -> frontend (nginx):80
#                     -> location /api/ -> api:8000
# O HSTS mora aqui; os demais cabeçalhos de segurança são emitidos pelo
# nginx do frontend.

judifiles.com.br {
	encode zstd gzip

	# IP real do cliente chega ao nginx via X-Forwarded-For (Caddy acrescenta)
	reverse_proxy frontend:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
