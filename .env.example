# JudiFiles — variáveis de ambiente (production)
# Copie para ".env" e ajuste. Em produção GERE valores novos.
# As duas primeiras são OBRIGATÓRIAS.

# ---------------------------------------------------------------- porta --------------------------------------------------------------
# Backend: 8000
# Frontend: 80 (Nginx)
# Importante: em produção o FRONTEND_PORT e API_TARGET são ignorados; o
# proxy Nginx já redireciona /api para o backend.

# ---------------------------------------------------------------- banco --------------------------------------------------------------
# Postgres (compose)
DATABASE_URL=postgresql://lexscan:lexscan-dev@db:5432/lexscan

# ---------------------------------------------------------------- storage LGPD --------------------------------------------------------------
# Chave de cifragem em repouso — NÃO reutilize em produção; gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=change-me-32-chars-minimum-secret-key-0123456789

# ---------------------------------------------------------------- fila de tarefas --------------------------------------------------------------
# local (dev) | celery (compose)
TASK_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/0

# ---------------------------------------------------------------- segurança --------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_MIN=60
PURGE_INTERVAL_MINUTES=30
RETENTION_HOURS=24
CLAMAV_ENABLED=false

# ---------------------------------------------------------------- desenvolvimento --------------------------------------------------------------
# só usado em ENVIRONMENT != prod
LOCAL_DEV_PASSWORD=lexscan-dev
