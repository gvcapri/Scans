# JudiFiles — exemplo de ambiente (copie para .env e edite).
#   cp .env.example .env
# O .env NUNCA vai para o git nem para as imagens Docker (.dockerignore).
# Cada linha indica o padrão usado pelo docker-compose.yml.

# ------------------------------------------------------------------ geral
# prod | dev. Em prod (padrão do compose) o app falha fechado: segredos
# fracos recusados no boot, usuário local nunca criado.
ENVIRONMENT=prod
# origens CORS permitidas (vírgula). Precisa bater com o domínio público.
CORS_ORIGINS=https://judifiles.com.br

# ------------------------------------------------------------------ banco
# nomes internos — não mudar em produção (identidade do banco)
POSTGRES_DB=lexscan
POSTGRES_USER=lexscan
# OBRIGATÓRIO. Gere um:  openssl rand -base64 24
POSTGRES_PASSWORD=troque-este-postgres-password

# ------------------------------------------------------------------ segredos
# OBRIGATÓRIO em prod: 32+ caracteres. Gere os DOIS:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STORAGE_SECRET cifra os arquivos em repouso.
STORAGE_SECRET=troque-este-segredo
# SECRET_KEY assina os tokens de sessão (JWT). Sem ele real, a API
# RECUSA subir em prod — um segredo fraco permitiria forjar sessões.
SECRET_KEY=troque-este-jwt-secret

# ------------------------------------------------------------------ fila
# local (padrão nesta VM: tarefas no processo da API, sem Redis)
# celery   (exige: docker compose --profile worker up -d)
TASK_BACKEND=local
CELERY_BROKER_URL=redis://redis:6379/0
WORKER_CONCURRENCY=1

# ------------------------------------------------------------------ LGPD
RETENTION_HOURS=24
# 0 = não agenda o expurgo automático (o "Apagar agora" continua valendo)
PURGE_INTERVAL_MINUTES=30
# cadastro aberto? feche rapidamente em caso de abuso
REGISTRATION_OPEN=true
# opcional: domínios permitidos no cadastro, vírgula (vazio = qualquer um)
ALLOWED_EMAIL_DOMAINS=
# ferramentas leves liberadas SEM login (vazio = nenhuma; ex.: integrity)
PUBLIC_TOOLS=

# ------------------------------------------------------------------ limites
MAX_UPLOAD_MB=100
# tamanho máximo do corpo no nginx (compose repassa pro build)
CLIENT_MAX_BODY_SIZE=100m
# timeout do proxy nginx para a API (uploads/processamento grandes)
API_READ_TIMEOUT=120s
AUTH_RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_MIN=120
# antivírus ClamAV (desligado: não roda nesta VM)
CLAMAV_ENABLED=false
# instala o binário tesseract na imagem (build); FEATURE_OCR liga a rota
ENABLE_OCR=false

# ------------------------------------------------------------------ feature flags
# Pesadas — DESLIGADAS por padrão nesta VM de 1 GB (respondem 503).
# Para reativar (ex.: VM maior): mude para true e reinicie o container.
FEATURE_OCR=false
FEATURE_COMPARE=false
FEATURE_REDACT=false
FEATURE_CONVERT=false
FEATURE_BATCH=false
# Leves — ligadas por padrão.
FEATURE_SEARCH=true
FEATURE_CASES=true
FEATURE_JOBS=true
FEATURE_NUMBERING=true
FEATURE_OUTLINE=true
FEATURE_INTEGRITY=true

# ------------------------------------------------------------------ desenvolvimento
# Só fora de prod: senha do usuário local de dev (NUNCA aceito em prod)
LOCAL_DEV_PASSWORD=lexscan-dev
