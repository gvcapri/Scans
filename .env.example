# LexScan — exemplo de variáveis de ambiente (.env)
# Copie para ".env" e ajuste. Em produção GERE valores novos.

# --- Aplicação ---
APP_NAME=LexScan
ENVIRONMENT=dev
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Banco de dados ---
# Dev local: SQLite. Docker Compose: postgres://lexscan:lexscan@db:5432/lexscan
DATABASE_URL=sqlite:///./lexscan.db

# --- Armazenamento (LGPD: cifragem em repouso) ---
STORAGE_ROOT=./storage
# Chave de cifragem em repouso. NÃO reutilize em produção; gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
STORAGE_SECRET=change-me-32-chars-minimum-secret-key-0123456789
STORAGE_BACKEND=disk

# --- Fila de tarefas ---
# local (ThreadPool, dev) | celery (Redis, produção/Docker)
TASK_BACKEND=local
CELERY_BROKER_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# --- Retenção / LGPD ---
RETENTION_HOURS=24
MAX_UPLOAD_MB=100

# --- OCR ---
# Vazio = autodetecta (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
TESSERACT_LANGS=por+eng
# Pasta com os *.traineddata (em dev aponta para ./tessdata)
TESSDATA_PREFIX=./tessdata

# --- Conversão Word (Fase 2) ---
# Vazio = autodetecta (Windows: C:\Program Files\LibreOffice\program\soffice.exe)
SOFFICE_CMD=

# --- Compressão / PDF-A (Fase 2, Ghostscript) ---
# Vazio = autodetecta (Windows: C:\Program Files\gs\gs*\bin\gswin64c.exe)
GHOSTSCRIPT_CMD=

# --- Segurança ---
SECRET_KEY=dev-only-jwt-secret-troque-em-producao
RATE_LIMIT_PER_MIN=60
CLAMAV_ENABLED=false
